# Endpoint GraphQL de tu backend (público para el blog)
GRAPHQL_API_URL=http://localhost:4000/graphql
NEXT_PUBLIC_GRAPHQL_API_URL=http://localhost:4000/graphql

# Secreto para firmar los JWT de Auth.js (genera uno con: openssl rand -base64 32)
AUTH_SECRET=reemplaza-con-tu-secreto

# Credenciales demo del panel (solo desarrollo local, se reemplazan por el login GraphQL)
DEMO_ADMIN_EMAIL=admin@slowlife.test
DEMO_ADMIN_PASSWORD=cambia-esta-clave

# URL base del sitio, usada para metadatos/canonical en producción
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AWS S3 para subida de imágenes (presigned URLs, solo se usan en el servidor)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=reemplaza-con-tu-access-key
AWS_SECRET_ACCESS_KEY=reemplaza-con-tu-secret
S3_BUCKET_NAME=reemplaza-con-tu-bucket
# Base URL pública de lectura de objetos (sin barra final)
S3_PUBLIC_BASE_URL=https://tu-bucket.s3.us-east-1.amazonaws.com
# Tamaño máximo permitido por imagen en bytes (por defecto 10 MB)
S3_MAX_UPLOAD_BYTES=10485760
